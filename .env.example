# Optional AI SDK provider. Leave keys empty for factual local analysis.
# AI runs only when you explicitly select AI analysis in the browser.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
AI_MAX_REPORT_COST_USD=1
# Economic target, independent of model context capacity (4,000–90,000 tokens).
AI_TARGET_INPUT_TOKENS=80000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional provider API root override; normally leave empty.
# Anthropic: https://api.anthropic.com/v1
# OpenAI: https://api.openai.com/v1
AI_BASE_URL=
# Local port is set to 4173 in package.json scripts.
# DATA_PATH=data/app.sqlite
